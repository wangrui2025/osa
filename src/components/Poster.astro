---
import { t } from '../i18n';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
---

<div class="osa-poster-root">
  <div class="osa-poster-wrapper" id="posterWrapper">
    <div class="osa-poster">
      <!-- ==================== HEADER ==================== -->
      <header class="osa-poster-header">
        <div class="osa-poster-header-left">
          <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/logos/szu.svg" alt="SZU Logo" class="osa-poster-logo-szu" onerror="this.classList.add('img-placeholder')">
          <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/logos/polyu.svg" alt="PolyU Logo" class="osa-poster-logo-polyu" onerror="this.classList.add('img-placeholder')">
        </div>
        <div class="osa-poster-header-center">
          <h1 class="osa-poster-paper-title">
            {t(lang, 'publicationTitle')}
          </h1>
          <div class="osa-poster-authors">
            Rui Wang<sup>1</sup>&nbsp;&nbsp;&nbsp;&nbsp;Huisi Wu<sup>1*</sup>&nbsp;&nbsp;&nbsp;&nbsp;Jing Qin<sup>2</sup>
          </div>
          <div class="osa-poster-affiliations">
            <sup>1</sup>{t(lang, 'affiliation1')}<br>
            <sup>2</sup>{t(lang, 'affiliation2')}
          </div>
        </div>
        <div class="osa-poster-header-right">
          <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/logos/cvpr2026.png" alt="CVPR 2026" class="osa-poster-logo-cvpr" onerror="this.classList.add('img-placeholder')">
        </div>
      </header>

      <!-- ==================== CONTENT ==================== -->
      <main class="osa-poster-content">
        <!-- COLUMN 1: Problem & Motivation -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.problemSettingTitle')}</h2>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.problemSettingBody')}
                <ul>
                  <li set:html={t(lang, 'poster.problemSettingPoint1')} />
                  <li set:html={t(lang, 'poster.problemSettingPoint2')} />
                  <li set:html={t(lang, 'poster.problemSettingPoint3')} />
                </ul>
              </div>
              <div class="osa-poster-figure">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/challenge/image.png" alt="Challenges" class="osa-poster-img--near-full" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.problemSettingFigureCaption')}</div>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.motivationTitle')}</h2>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.motivationBody')}
                <ul>
                  <li set:html={t(lang, 'poster.motivationPoint1')} />
                  <li set:html={t(lang, 'poster.motivationPoint2')} />
                  <li set:html={t(lang, 'poster.motivationPoint3')} />
                </ul>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.contributionsTitle')}</h2>
              <div class="osa-poster-section-body">
                <ul>
                  <li>{t(lang, 'poster.contribution1')}</li>
                  <li>{t(lang, 'poster.contribution2')}</li>
                  <li>{t(lang, 'poster.contribution3')}</li>
                  <li set:html={t(lang, 'poster.contribution4')} />
                  <li set:html={t(lang, 'poster.contribution5')} />
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 2: Approach & Overview -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.ourApproachTitle')}</h2>
              <div class="osa-poster-section-body">
                <Fragment set:html={t(lang, 'poster.ourApproachBody')} />
                <ul>
                  <li set:html={t(lang, 'poster.ourApproachPoint1')} />
                  <li set:html={t(lang, 'poster.ourApproachPoint2')} />
                </ul>
              </div>
              <div class="osa-poster-figure">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/first/fig_first.png" alt="OSA Teaser" class="osa-poster-img--95" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.ourApproachFigureCaption')}</div>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.methodOverviewTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.methodOverviewBody')}>
              </div>
              <div class="osa-poster-figure">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/Met/fig_overview.png" alt="OSA Architecture" class="osa-poster-img--near-full" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.methodOverviewFigureCaption')}</div>
              </div>
              <div class="osa-poster-section-body">
                <strong>{t(lang, 'poster.methodOverviewPipeline')}</strong>
                <ol style="padding-left: 0.52in; margin: 0.15in 0;">
                  <li set:html={t(lang, 'poster.pipelineStep1')} />
                  <li set:html={t(lang, 'poster.pipelineStep2')} />
                  <li set:html={t(lang, 'poster.pipelineStep3')} />
                  <li set:html={t(lang, 'poster.pipelineStep4')} />
                  <li set:html={t(lang, 'poster.pipelineStep5')} />
                </ol>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 3: Method Details -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.osuTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.osuBody')}>
              </div>
              <div class="osa-poster-formula-box">
                <div class="osa-poster-formula">
                  <strong>𝒱</strong><sub>C<sub>v</sub>, C<sub>k</sub></sub> = &#123; <strong>S</strong> &isin; &real;<sup>C<sub>v</sub>&times;C<sub>k</sub></sup> : <strong>S</strong><sup>T</sup><strong>S</strong> = <strong>I</strong><sub>C<sub>k</sub></sub> &#125;
                </div>
                <div class="osa-poster-formula">
                  <strong>S</strong><sub>t</sub><sup>Euc</sup> = <strong>S</strong><sub>t&minus;1</sub>(<strong>&alpha;</strong><sub>t</sub>(<strong>I</strong><sub>C<sub>k</sub></sub> &minus; <strong>&beta;</strong><sub>t</sub><strong>k</strong><sub>t</sub><strong>k</strong><sub>t</sub><sup>T</sup>)) + <strong>&beta;</strong><sub>t</sub><strong>v</strong><sub>t</sub><strong>k</strong><sub>t</sub><sup>T</sup>
                </div>
                <div class="osa-poster-formula">
                  <strong>X</strong><sup>(0)</sup> = <strong>S</strong><sub>t</sub><sup>Euc</sup> / (&par;<strong>S</strong><sub>t</sub><sup>Euc</sup>&par;<sub>F</sub> + &epsilon;)
                </div>
                <div class="osa-poster-formula">
                  <strong>X</strong><sup>(j+1)</sup> = <strong>a</strong><strong>X</strong><sup>(j)</sup> + <strong>b</strong><strong>X</strong><sup>(j)</sup>(<strong>X</strong><sup>(j)</sup>)<sup>T</sup><strong>X</strong><sup>(j)</sup> + <strong>c</strong><strong>X</strong><sup>(j)</sup>((<strong>X</strong><sup>(j)</sup>)<sup>T</sup><strong>X</strong><sup>(j)</sup>)<sup>2</sup>
                </div>
              </div>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.osuBody2')}
              </div>
              <div class="osa-poster-figure osa-poster-figure--flush">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/osu/fig_osu.png" alt="OSU Detail" class="osa-poster-img--95" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.osuFigureCaption')}</div>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.apfeTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.apfeBody')}>
              </div>
              <div class="osa-poster-figure osa-poster-figure--flush">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/apfe/fig_apfe.png" alt="APFE Detail" class="osa-poster-img--95" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.apfeFigureCaption')}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 4: Contributions & Experiments -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.quantitativeResultsTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.quantitativeResultsBody')}>
              </div>
              <div class="osa-poster-table-wrap">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/tab/tab_cap.png" alt="Main Results"  onerror="this.classList.add('img-placeholder')">
              </div>
              <div class="osa-poster-figure-caption">{t(lang, 'poster.quantitativeResultsTableCaption')}</div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.qualitativeComparisonTitle')}</h2>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.qualitativeComparisonBody')}
              </div>
              <div class="osa-poster-figure osa-poster-figure--flush">
                <img loading="eager" src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/Exp/image.png" alt="Qualitative Results" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.qualitativeComparisonFigureCaption')}</div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- ==================== FOOTER ==================== -->
      <footer class="osa-poster-footer">
        <div class="osa-poster-footer-section">
          <h3>{t(lang, 'poster.footerCode')}</h3>
          <div class="osa-poster-footer-links">
            <a href="https://github.com/wangrui2025/OSA" class="osa-poster-footer-link" target="_blank">
              <span>github.com/wangrui2025/OSA</span>
            </a>
          </div>
        </div>
        <div class="osa-poster-footer-section">
          <h3>{t(lang, 'poster.footerConference')}</h3>
          <p>{t(lang, 'poster.footerConferenceInfo')}</p>
        </div>
        <div class="osa-poster-footer-section">
          <h3>{t(lang, 'poster.footerContact')}</h3>
          <div class="osa-poster-footer-links">
            <a href="mailto:hswu@szu.edu.cn" class="osa-poster-footer-link">
              <span>hswu@szu.edu.cn</span>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <!-- Preview Controls -->
  <div class="osa-poster-preview-controls" id="previewControls">
    <span>{t(lang, 'poster.previewLabel')} <span id="zoomLevel">100%</span></span>
    <button onclick="zoomIn()">+</button>
    <button onclick="zoomOut()">&minus;</button>
    <button onclick="fitToScreen()">Fit</button>
    <button onclick="window.print()">{t(lang, 'poster.downloadPdf')}</button>
    <button onclick="window.print()">{t(lang, 'poster.printPdf')}</button>
  </div>
</div>

<style>
  /* ===========================================
     PRINT SETTINGS
     =========================================== */
  @media print {
    @page {
      margin: 0;
      size: a0 landscape;
    }
    .osa-poster-root {
      width: 84in;
      height: 42in;
      overflow: hidden;
      background: white;
    }
    .osa-poster-wrapper {
      transform: none !important;
      width: 84in !important;
      height: 42in !important;
    }
    .osa-poster-header,
    .osa-poster-footer,
    .osa-poster-section-title,
    .osa-poster-highlight {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .osa-poster-preview-controls {
      display: none !important;
    }
  }

  /* ===========================================
     RESET & BASE
     =========================================== */
  .osa-poster-root *, .osa-poster-root *::before, .osa-poster-root *::after {
    box-sizing: border-box;
  }

  .osa-poster-root {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #f0f0f0;
    font-family: 'Times New Roman', Times, Georgia, serif;
  }

  /* ===========================================
     POSTER CONTAINER
     =========================================== */
  .osa-poster-wrapper {
    width: 84in;
    height: 42in;
    position: relative;
    background: white;
    overflow: hidden;
    box-shadow: 0 0 50px rgba(0,0,0,0.3);
  }

  .osa-poster {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: 7.4in minmax(0, 1fr) 1.6in;
    grid-template-areas:
      "header"
      "content"
      "footer";
  }

  /* ===========================================
     HEADER
     =========================================== */
  .osa-poster-header {
    grid-area: header;
    background: linear-gradient(135deg, #7F9EE6 0%, #7F9EE6 50%, #7F9EE6 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.2in 0.4in;
    position: relative;
    overflow: hidden;
    border-bottom: 7pt solid #7F9EE6;
  }

  .osa-poster-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }

  .osa-poster-header-left {
    display: flex;
    align-items: center;
    gap: 0.6in;
    z-index: 1;
  }

  .osa-poster-logo-szu {
    width: 3.5in;
    height: auto;
    opacity: 0.95;
  }

  .osa-poster-header-center {
    text-align: center;
    flex: 1;
    z-index: 1;
    padding: 0 0.5in;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .osa-poster-paper-title {
    font-size: 119pt;
    font-weight: bold;
    line-height: 1.1;
    letter-spacing: -0.3pt;
    margin-top: 0;
    margin-bottom: 0.05in;
    color: #000000;
  }

  .osa-poster-paper-title .osa-poster-highlight {
    color: #000000;
  }

  .osa-poster-authors {
    font-size: 53pt;
    margin-bottom: 0.05in;
    color: #000000;
  }

  .osa-poster-affiliations {
    font-size: 37pt;
    color: #000000;
    line-height: 1.1;
    margin-bottom: 0;
  }

  .osa-poster-header-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05in;
    z-index: 1;
    min-width: 3.5in;
  }

  .osa-poster-logo-cvpr {
    width: 12in;
    height: auto;
    opacity: 0.95;
  }

  .osa-poster-logo-polyu {
    width: 3.5in;
    height: auto;
    opacity: 0.95;
  }

  .osa-poster-conf-info {
    font-size: 44pt;
    color: #000000;
    text-align: center;
    font-weight: bold;
    letter-spacing: 1pt;
  }

  /* ===========================================
     CONTENT GRID
     =========================================== */
  .osa-poster-content {
    grid-area: content;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 1fr;
    gap: 0;
    padding: 0.15in 0.25in;
    overflow: hidden;
  }

  .osa-poster-column {
    padding: 0.15in 0.4in;
    border-right: 2.25pt solid #e8e8e8;
    overflow: hidden;
    min-height: 0;
  }

  .osa-poster-column:last-child {
    border-right: none;
  }

  .osa-poster-column-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.15in;
    overflow: hidden;
  }

  /* ===========================================
     SECTIONS
     =========================================== */
  .osa-poster-section {
    display: flex;
    flex-direction: column;
    gap: 0.08in;
    flex: 1 1 auto;
    min-height: 0;
  }

  .osa-poster-section-title {
    font-size: 66pt;
    font-weight: bold;
    color: #5A6FCA;
    border-bottom: 2.5pt solid #5A6FCA;
    padding-bottom: 0.1in;
    margin-top: 0;
    margin-bottom: 0.12in;
    line-height: 1.2;
  }

  .osa-poster-section-subtitle {
    font-size: 52pt;
    font-weight: bold;
    color: #4655AB;
    margin-top: 0.12in;
    margin-bottom: 0.08in;
  }

  .osa-poster-section-body {
    font-size: 46pt;
    line-height: 1.4;
    color: #1a1a1a;
    text-align: justify;
  }

  .osa-poster-section-body ul {
    list-style: disc;
    padding-left: 0.4in;
    margin: 0.23in 0;
  }

  .osa-poster-section-body li {
    margin-bottom: 0.12in;
  }

  .osa-poster-section-body strong {
    color: #4655AB;
  }

  /* ===========================================
     FIGURES
     =========================================== */
  .osa-poster-figure {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.08in;
    margin: 0.15in 0;
    border-radius: 9pt;
    border: 2.25pt solid #e0e0e0;
    overflow: hidden;
  }

  .osa-poster-figure img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 8in;
    object-fit: cover;
    margin: 0;
  }

  .osa-poster-figure img.osa-poster-img--95 {
    width: 95%;
    margin-left: auto;
    margin-right: auto;
    object-fit: contain;
  }

  .osa-poster-figure--flush img.osa-poster-img--95 {
    max-height: 8.5in;
  }

  .osa-poster-figure img.osa-poster-img--near-full {
    width: 95%;
    margin-left: auto;
    margin-right: auto;
    object-fit: contain;
  }

  .osa-poster-figure--flush {
    padding: 0 !important;
  }

  .osa-poster-figure--flush img {
    border-radius: 0;
    object-fit: contain;
    max-height: 7in;
  }

  .osa-poster-figure-caption {
    font-size: 30pt;
    color: #444;
    text-align: center;
    font-style: italic;
    line-height: 1.3;
    margin-top: 0.06in;
  }

  img.img-placeholder {
    min-height: 2in;
    background: linear-gradient(135deg, #e8e8e8 0%, #f0f0f0 50%, #e8e8e8 100%);
    border: 2pt dashed #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    object-fit: none;
  }
  img.img-placeholder::after {
    content: attr(alt);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 24pt;
    color: #888;
    font-style: italic;
    text-align: center;
    white-space: nowrap;
  }

  /* ===========================================
     FORMULAS
     =========================================== */
  .osa-poster-formula-box {
    background: #f8f9fa;
    border-left: 4.5pt solid #5A6FCA;
    padding: 0.05in;
    margin: 0.05in 0;
    font-size: 36pt;
    line-height: 1.3;
    color: #1a1a1a;
    border-radius: 0 4pt 4pt 0;
  }

  .osa-poster-formula-box .osa-poster-formula {
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    text-align: center;
    margin: 0.1in 0;
  }

  /* ===========================================
     TABLES
     =========================================== */
  .osa-poster-table-wrap {
    width: 100%;
    overflow: hidden;
    margin: 0.15in 0;
  }

  .osa-poster-table-wrap img {
    width: 100%;
    height: auto;
    max-height: 6in;
    object-fit: contain;
  }

  /* ===========================================
     FOOTER
     =========================================== */
  .osa-poster-footer {
    grid-area: footer;
    background: #7F9EE6;
    color: white;
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr;
    gap: 0.35in;
    padding: 0.1in 0.25in;
    align-items: start;
  }

  .osa-poster-footer-section h3 {
    font-size: 38pt;
    color: #000000;
    margin-top: 0;
    margin-bottom: 0;
    border-bottom: 1.5pt solid #7F9EE6;
    padding-bottom: 0;
    line-height: 1.1;
  }

  .osa-poster-footer-section p,
  .osa-poster-footer-section li {
    font-size: 26pt;
    line-height: 1.1;
    color: #000000;
    margin-top: 0;
    margin-bottom: 0;
  }

  .osa-poster-footer-section ul {
    list-style: none;
    padding: 0;
  }

  .osa-poster-footer-section li {
    margin-bottom: 0.06in;
  }

  .osa-poster-footer-links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .osa-poster-footer-link {
    display: flex;
    align-items: flex-start;
    gap: 0.06in;
    font-size: 24pt;
    color: #000000;
    text-decoration: none;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: normal;
    line-height: 1.2;
  }

  .osa-poster-footer-link span {
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .osa-poster-qr-placeholder {
    width: 1.8in;
    height: 1.8in;
    background: white;
    border-radius: 6pt;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 21pt;
    color: #333;
  }

  /* ===========================================
     PREVIEW MODE (for screen viewing)
     =========================================== */
  .osa-poster-preview-controls {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: rgba(0,0,0,0.8);
    color: white;
    padding: 18px 30px;
    border-radius: 8px;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 21px;
    z-index: 1000;
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .osa-poster-preview-controls button {
    background: #7F9EE6;
    border: none;
    color: #F3F7FF;
    padding: 9px 21px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    font-size: 20px;
