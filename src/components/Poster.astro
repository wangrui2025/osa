---
import { t } from '../i18n';
import PosterHeader from './PosterHeader.astro';
import { getAcademicImage } from '../utils/cdn';
import '../styles/poster.css';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;

const figChallenge = getAcademicImage('publications/cvpr2026-osa/fig/challenge/image.png');
const figFirst = getAcademicImage('publications/cvpr2026-osa/fig/first/fig_first.png');
const figOverview = getAcademicImage('publications/cvpr2026-osa/fig/Met/fig_overview.png');
const figOsu = getAcademicImage('publications/cvpr2026-osa/fig/osu/fig_osu.png');
const figApfe = getAcademicImage('publications/cvpr2026-osa/fig/apfe/fig_apfe.png');
const tabCap = getAcademicImage('publications/cvpr2026-osa/tab/tab_cap.png');
const figExp = getAcademicImage('publications/cvpr2026-osa/fig/Exp/image.png');
---

<div class="osa-poster-root">
  <div class="osa-poster-wrapper" id="posterWrapper">
    <div class="osa-poster">
      <PosterHeader lang={lang} />

      <!-- ==================== CONTENT ==================== -->
      <main class="osa-poster-content">
        <!-- COLUMN 1: Problem & Motivation -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.problemSettingTitle')}</h2>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.problemSettingBody')}
                <ul>
                  <li set:html={t(lang, 'poster.problemSettingPoint1')} />
                  <li set:html={t(lang, 'poster.problemSettingPoint2')} />
                  <li set:html={t(lang, 'poster.problemSettingPoint3')} />
                </ul>
              </div>
              <div class="osa-poster-figure">
                <img loading="lazy" src={figChallenge} alt="Challenges" class="osa-poster-img--near-full" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.problemSettingFigureCaption')}</div>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.motivationTitle')}</h2>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.motivationBody')}
                <ul>
                  <li set:html={t(lang, 'poster.motivationPoint1')} />
                  <li set:html={t(lang, 'poster.motivationPoint2')} />
                  <li set:html={t(lang, 'poster.motivationPoint3')} />
                </ul>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.contributionsTitle')}</h2>
              <div class="osa-poster-section-body">
                <ul>
                  <li>{t(lang, 'poster.contribution1')}</li>
                  <li>{t(lang, 'poster.contribution2')}</li>
                  <li>{t(lang, 'poster.contribution3')}</li>
                  <li set:html={t(lang, 'poster.contribution4')} />
                  <li set:html={t(lang, 'poster.contribution5')} />
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 2: Approach & Overview -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.ourApproachTitle')}</h2>
              <div class="osa-poster-section-body">
                <Fragment set:html={t(lang, 'poster.ourApproachBody')} />
                <ul>
                  <li set:html={t(lang, 'poster.ourApproachPoint1')} />
                  <li set:html={t(lang, 'poster.ourApproachPoint2')} />
                </ul>
              </div>
              <div class="osa-poster-figure">
                <img loading="eager" src={figFirst} alt="OSA Teaser" class="osa-poster-img--95" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.ourApproachFigureCaption')}</div>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.methodOverviewTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.methodOverviewBody')}>
              </div>
              <div class="osa-poster-figure">
                <img loading="eager" src={figOverview} alt="OSA Architecture" class="osa-poster-img--near-full" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.methodOverviewFigureCaption')}</div>
              </div>
              <div class="osa-poster-section-body">
                <strong>{t(lang, 'poster.methodOverviewPipeline')}</strong>
                <ol style="padding-left: 0.52in; margin: 0.15in 0;">
                  <li set:html={t(lang, 'poster.pipelineStep1')} />
                  <li set:html={t(lang, 'poster.pipelineStep2')} />
                  <li set:html={t(lang, 'poster.pipelineStep3')} />
                  <li set:html={t(lang, 'poster.pipelineStep4')} />
                  <li set:html={t(lang, 'poster.pipelineStep5')} />
                </ol>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 3: Method Details -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.osuTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.osuBody')}>
              </div>
              <div class="osa-poster-formula-box">
                <div class="osa-poster-formula">
                  <strong>𝒱</strong><sub>C<sub>v</sub>, C<sub>k</sub></sub> = &#123; <strong>S</strong> &isin; &real;<sup>C<sub>v</sub>&times;C<sub>k</sub></sup> : <strong>S</strong><sup>T</sup><strong>S</strong> = <strong>I</strong><sub>C<sub>k</sub></sub> &#125;
                </div>
                <div class="osa-poster-formula">
                  <strong>S</strong><sub>t</sub><sup>Euc</sup> = <strong>S</strong><sub>t&minus;1</sub>(<strong>&alpha;</strong><sub>t</sub>(<strong>I</strong><sub>C<sub>k</sub></sub> &minus; <strong>&beta;</strong><sub>t</sub><strong>k</strong><sub>t</sub><strong>k</strong><sub>t</sub><sup>T</sup>)) + <strong>&beta;</strong><sub>t</sub><strong>v</strong><sub>t</sub><strong>k</strong><sub>t</sub><sup>T</sup>
                </div>
                <div class="osa-poster-formula">
                  <strong>X</strong><sup>(0)</sup> = <strong>S</strong><sub>t</sub><sup>Euc</sup> / (&par;<strong>S</strong><sub>t</sub><sup>Euc</sup>&par;<sub>F</sub> + &epsilon;)
                </div>
                <div class="osa-poster-formula">
                  <strong>X</strong><sup>(j+1)</sup> = <strong>a</strong><strong>X</strong><sup>(j)</sup> + <strong>b</strong><strong>X</strong><sup>(j)</sup>(<strong>X</strong><sup>(j)</sup>)<sup>T</sup><strong>X</strong><sup>(j)</sup> + <strong>c</strong><strong>X</strong><sup>(j)</sup>((<strong>X</strong><sup>(j)</sup>)<sup>T</sup><strong>X</strong><sup>(j)</sup>)<sup>2</sup>
                </div>
              </div>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.osuBody2')}
              </div>
              <div class="osa-poster-figure osa-poster-figure--flush">
                <img loading="eager" src={figOsu} alt="OSU Detail" class="osa-poster-img--95" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.osuFigureCaption')}</div>
              </div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.apfeTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.apfeBody')}>
              </div>
              <div class="osa-poster-figure osa-poster-figure--flush">
                <img loading="eager" src={figApfe} alt="APFE Detail" class="osa-poster-img--95" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.apfeFigureCaption')}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 4: Contributions & Experiments -->
        <div class="osa-poster-column">
          <div class="osa-poster-column-inner">
            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.quantitativeResultsTitle')}</h2>
              <div class="osa-poster-section-body" set:html={t(lang, 'poster.quantitativeResultsBody')}>
              </div>
              <div class="osa-poster-table-wrap">
                <img loading="eager" src={tabCap} alt="Main Results" onerror="this.classList.add('img-placeholder')">
              </div>
              <div class="osa-poster-figure-caption">{t(lang, 'poster.quantitativeResultsTableCaption')}</div>
            </div>

            <div class="osa-poster-section">
              <h2 class="osa-poster-section-title">{t(lang, 'poster.qualitativeComparisonTitle')}</h2>
              <div class="osa-poster-section-body">
                {t(lang, 'poster.qualitativeComparisonBody')}
              </div>
              <div class="osa-poster-figure osa-poster-figure--flush">
                <img loading="eager" src={figExp} alt="Qualitative Results" onerror="this.classList.add('img-placeholder')">
                <div class="osa-poster-figure-caption">{t(lang, 'poster.qualitativeComparisonFigureCaption')}</div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- ==================== FOOTER ==================== -->
      <footer class="osa-poster-footer">
        <div class="osa-poster-footer-section">
          <h3 class="osa-poster-footer-title">{t(lang, 'poster.footerCode')}</h3>
          <div class="osa-poster-footer-links">
            <a href="https://github.com/wangrui2025/OSA" class="osa-poster-footer-link" target="_blank" rel="noopener noreferrer">
              <span>github.com/wangrui2025/OSA</span>
            </a>
          </div>
        </div>
        <div class="osa-poster-footer-section">
          <h3 class="osa-poster-footer-title">{t(lang, 'poster.footerConference')}</h3>
          <p>{t(lang, 'poster.footerConferenceInfo')}</p>
        </div>
        <div class="osa-poster-footer-section">
          <h3 class="osa-poster-footer-title">{t(lang, 'poster.footerContact')}</h3>
          <div class="osa-poster-footer-links">
            <a href="mailto:hswu@szu.edu.cn" class="osa-poster-footer-link">
              <span>hswu@szu.edu.cn</span>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </div>

  <!-- Preview Controls -->
  <div class="osa-poster-preview-controls" id="previewControls">
    <span>{t(lang, 'poster.previewLabel')} <span id="zoomLevel">100%</span></span>
    <button data-action="zoom-in" aria-label={t(lang, 'poster.zoomIn')}>+</button>
    <button data-action="zoom-out" aria-label={t(lang, 'poster.zoomOut')}>&minus;</button>
    <button data-action="fit-screen" aria-label={t(lang, 'poster.fitScreen')}>Fit</button>
    <button data-action="save-pdf" aria-label={t(lang, 'poster.savePdf')}>{t(lang, 'poster.savePdf')}</button>
    <button data-action="print-pdf" aria-label={t(lang, 'poster.printPdf')}>{t(lang, 'poster.printPdf')}</button>
  </div>
</div>

<script>
  const POSTER_W = 84 * 96; // 8064
  const POSTER_H = 42 * 96; // 4032
  const MIN_ZOOM = 0.05;
  const MAX_ZOOM = 1.0;

  function fitToScreen() {
    const controls = document.getElementById('previewControls');
    const padding = 40;
    const controlsH = controls ? controls.offsetHeight : 60;
    const availW = Math.max(window.innerWidth - padding, 200);
    const availH = Math.max(window.innerHeight - padding - controlsH, 200);
    const scale = Math.min(availW / POSTER_W, availH / POSTER_H, 1);
    currentScale = Math.max(scale, MIN_ZOOM);
    applyZoom();
  }

  function fitWidth() {
    const padding = 40;
    const availW = Math.max(window.innerWidth - padding, 200);
    currentScale = Math.min(Math.max(availW / POSTER_W, MIN_ZOOM), MAX_ZOOM);
    applyZoom();
  }

  let currentScale = 0.22;

  function zoomIn() {
    currentScale = Math.min(currentScale * 1.2, MAX_ZOOM);
    applyZoom();
  }
  function zoomOut() {
    currentScale = Math.max(currentScale / 1.2, MIN_ZOOM);
    applyZoom();
  }
  function applyZoom() {
    const wrapper = document.getElementById('posterWrapper');
    const controlsH = document.getElementById('previewControls')?.offsetHeight ?? 60;
    if (!wrapper) {
      console.error('[poster.astro] #posterWrapper missing; aborting applyZoom');
      return;
    }
    const scaledH = POSTER_H * currentScale;
    const scaledW = POSTER_W * currentScale;
    wrapper.style.transformOrigin = 'top left';
    wrapper.style.transform = `scale(${currentScale})`;
    wrapper.style.left = `${Math.max((window.innerWidth - scaledW) / 2, 10)}px`;
    if (scaledH + controlsH + 40 <= window.innerHeight) {
      wrapper.style.top = `${Math.max((window.innerHeight - scaledH - controlsH) / 2, 10)}px`;
    } else {
      wrapper.style.top = '10px';
    }
    const zoomLevelEl = document.getElementById('zoomLevel');
    if (zoomLevelEl) zoomLevelEl.textContent = Math.round(currentScale * 100) + '%';
  }

  window.addEventListener('load', () => { requestAnimationFrame(fitWidth); });
  window.addEventListener('resize', () => { requestAnimationFrame(fitWidth); });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-action]');
    if (!btn) return;
    switch (btn.getAttribute('data-action')) {
      case 'zoom-in': zoomIn(); break;
      case 'zoom-out': zoomOut(); break;
      case 'fit-screen': fitToScreen(); break;
      case 'print-pdf': window.print(); break;
      case 'save-pdf': window.print(); break;
    }
  });
</script>
