---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import { getAcademicImage } from '../utils/cdn';

const currentLocale = Astro.currentLocale ?? 'en';
const targetLocale = currentLocale === 'en' ? 'zh' : 'en';
const currentPath = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '')
  .replace(/^\/(en|zh)/, '')
  .replace(/\/$/, '') || '/';
const targetUrl = getRelativeLocaleUrl(targetLocale, currentPath);
const translateIcon = getAcademicImage('icons/translate.svg');
// `langSwitchLabel` is the LABEL of the OTHER locale (target), not an
// action verb: en viewer sees "中文", zh viewer sees "EN". The key name
// makes that semantic explicit. (Previously mis-named `langSwitch`.)
---

<a
  href={targetUrl}
  class="flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white rounded-full px-4 py-2 text-sm font-bold transition-colors shadow-md"
  title="Switch Language"
  aria-label={currentLocale === 'zh' ? t('en', 'langSwitchAriaLabel') : t('zh', 'langSwitchAriaLabel')}
>
  <img src={translateIcon} alt={t(targetLocale, 'langSwitchLabel')} class="h-4 w-auto" loading="lazy" decoding="async" />
</a>
