---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';

const currentLocale = Astro.currentLocale ?? 'en';
const targetLocale = currentLocale === 'en' ? 'zh' : 'en';
const currentPath = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '')
  .replace(/^\/(en|zh)/, '')
  .replace(/\/$/, '') || '/';
const targetUrl = getRelativeLocaleUrl(targetLocale, currentPath);
const switchLabel = t(targetLocale, 'langSwitch');
---

<a
  href={targetUrl}
  class="flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white rounded-full px-4 py-2 text-sm font-bold transition-colors shadow-md"
  title="Switch Language"
>
  <img src="https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/icons/translate.svg" alt="Translate" class="h-4 w-auto" loading="lazy" decoding="async" />
  <span>{switchLabel}</span>
</a>
