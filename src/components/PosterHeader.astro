---
import { t } from '../i18n';
import { getAcademicImage } from '../utils/cdn';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;

const szuLogo = getAcademicImage('logos/szu.svg');
const polyuLogo = getAcademicImage('logos/polyu.svg');
const cvprLogo = getAcademicImage('logos/cvpr2026.png');
---

<header class="osa-poster-header">
  <div class="osa-poster-header-left">
    <img loading="eager" src={szuLogo} alt="Shenzhen University logo" class="osa-poster-logo-szu" data-image-fallback width="252" height="80">
    <img loading="eager" src={polyuLogo} alt="Hong Kong Polytechnic University logo" class="osa-poster-logo-polyu" data-image-fallback width="252" height="80">
  </div>
  <div class="osa-poster-header-center">
    <h1 class="osa-poster-paper-title">
      {t(lang, 'publicationTitle')}
    </h1>
    <div class="osa-poster-authors">
      Rui Wang<sup>1</sup>&nbsp;&nbsp;&nbsp;&nbsp;Huisi Wu<sup>1*</sup>&nbsp;&nbsp;&nbsp;&nbsp;Jing Qin<sup>2</sup>
    </div>
    <div class="osa-poster-affiliations">
      <sup>1</sup>{t(lang, 'affiliation1')}<br>
      <sup>2</sup>{t(lang, 'affiliation2')}
    </div>
  </div>
  <div class="osa-poster-header-right">
    <img loading="eager" src={cvprLogo} alt="CVPR 2026 conference logo" class="osa-poster-logo-cvpr" data-image-fallback width="864" height="230">
  </div>
</header>

<style>
  .osa-poster-header {
    grid-area: header;
    background: linear-gradient(135deg, #7F9EE6 0%, #7F9EE6 50%, #7F9EE6 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.2in 0.4in;
    position: relative;
    overflow: hidden;
    border-bottom: 7pt solid #7F9EE6;
  }

  .osa-poster-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }

  .osa-poster-header-left {
    display: flex;
    align-items: center;
    gap: 0.6in;
    z-index: 1;
  }

  .osa-poster-logo-szu {
    width: 3.5in;
    height: auto;
    opacity: 0.95;
  }

  .osa-poster-header-center {
    text-align: center;
    flex: 1;
    z-index: 1;
    padding: 0 0.5in;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .osa-poster-paper-title {
    font-size: 119pt;
    font-weight: bold;
    line-height: 1.1;
    letter-spacing: -0.3pt;
    margin-top: 0;
    margin-bottom: 0.05in;
    color: #000000;
  }

  .osa-poster-authors {
    font-size: 53pt;
    margin-bottom: 0.05in;
    color: #000000;
  }

  .osa-poster-affiliations {
    font-size: 37pt;
    color: #000000;
    line-height: 1.1;
    margin-bottom: 0;
  }

  .osa-poster-header-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05in;
    z-index: 1;
    min-width: 3.5in;
  }

  .osa-poster-logo-cvpr {
    width: 12in;
    height: auto;
    opacity: 0.95;
  }

  .osa-poster-logo-polyu {
    width: 3.5in;
    height: auto;
    opacity: 0.95;
  }
</style>
