---
import { t } from '../i18n';
interface Props { lang: 'en' | 'zh'; }
const { lang } = Astro.props;
const txt = (key: string) => t(lang, 'compare.' + key);
const root = import.meta.env.BASE_URL + '/' + lang + '/';
const base = root + 'explore/';
const cards = [
  {id:'A',kind:'video-first',label:txt('aName'),tag:txt('aTag'),desc:txt('aDesc')},
  {id:'B',kind:'network-first',label:txt('bName'),tag:txt('bTag'),desc:txt('bDesc')}
];
---
<div class="osa-study" data-osa-comparison data-lang={lang}>
  <nav class="study-topbar" aria-label={txt('navLabel')}>
    <a class="study-brand" href={root}><span class="study-brand-mark">O</span><span>OSA <small>EXPLORABLE PAPER</small></span></a>
    <div class="study-topnav"><a href={root}>{txt('returnPaper')}</a><a href={import.meta.env.BASE_URL + '/' + (lang === 'en' ? 'zh' : 'en') + '/explore/'}>{lang === 'en' ? '中文' : 'EN'}</a></div>
  </nav>
  <div class="comparison-shell">
    <div class="comparison-hero">
      <p class="study-kicker"><span class="study-status-dot"></span>{txt('eyebrow')}</p>
      <h1>{txt('title')}</h1>
      <p>{txt('intro')}</p>
      <div class="comparison-rules"><span>{txt('rule1')}</span><span>{txt('rule2')}</span><span>{txt('rule3')}</span></div>
    </div>
    <div class="comparison-cards">
      {cards.map(card => (
        <article class="comparison-card">
          <div class={'comparison-thumbnail comparison-thumbnail--' + card.kind}>
            <div class="comparison-thumb-top"><span>OSA / {card.id}</span><span>{card.tag}</span></div>
            {card.id === 'A' ? (
              <div class="comparison-ultrasound" aria-hidden="true">
                <svg viewBox="0 0 300 150">
                  <defs><radialGradient id="echoPreview"><stop stop-color="#839ca4" stop-opacity=".56"/><stop offset=".6" stop-color="#34475d"/><stop offset="1" stop-color="#0e1d30"/></radialGradient></defs>
                  <path d="M150 5 L280 143 H20 Z" fill="url(#echoPreview)" stroke="#507183" stroke-width="1"/>
                  <ellipse cx="150" cy="91" rx="48" ry="34" fill="#15283d" stroke="#91efd9" stroke-width="3"/>
                  <path d="M100 69 Q150 30 203 75" stroke="#b1d1d4" stroke-opacity=".65" stroke-width="3" fill="none"/>
                </svg>
                <div><span class="comparison-thumb-timeline"></span></div>
              </div>
            ) : (
              <div class="comparison-diagram" aria-hidden="true">
                <span>ResNet</span><b>→</b><span>APFE</span><b>→</b><span>OSU</span><b>→</b><span>Mask</span>
                <div>Sₜ₋₁ ↶ Sₜ</div>
              </div>
            )}
          </div>
          <div class="comparison-card-body">
            <div class="comparison-card-number">{card.id} / 02</div>
            <h2>{card.label}</h2>
            <p>{card.desc}</p>
            <a class="comparison-open" href={base + card.kind + '/'}>{txt('open')} {card.id} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>

    <section class="comparison-constants">
      <h2>{txt('heldConstant')}</h2>
      <p>{txt('heldConstantDesc')}</p>
      <div class="comparison-constant-grid">
        <div><span>01</span><strong>{txt('constant1')}</strong><p>{txt('constant1Desc')}</p></div>
        <div><span>02</span><strong>{txt('constant2')}</strong><p>{txt('constant2Desc')}</p></div>
        <div><span>03</span><strong>{txt('constant3')}</strong><p>{txt('constant3Desc')}</p></div>
      </div>
    </section>

    <section class="comparison-feedback" aria-labelledby="comparison-feedback-title">
      <div>
        <p class="study-section-id">{txt('feedbackEyebrow')}</p>
        <h2 id="comparison-feedback-title">{txt('feedbackTitle')}</h2>
        <p>{txt('feedbackDesc')}</p>
        <p class="comparison-privacy">{txt('privacyNote')}</p>
      </div>
      <form class="comparison-form" data-comparison-form>
        <fieldset>
          <legend>{txt('choose')}</legend>
          <label><input type="radio" name="preferred" value="A"/> A · {txt('aName')}</label>
          <label><input type="radio" name="preferred" value="B"/> B · {txt('bName')}</label>
          <label><input type="radio" name="preferred" value="Hybrid"/> {txt('mixed')}</label>
          <label><input type="radio" name="preferred" value="Undecided" checked/> {txt('undecided')}</label>
        </fieldset>
        <label class="comparison-write">{txt('feedbackPrompt')}
          <textarea data-comparison-comment rows="4" placeholder={txt('placeholder')}></textarea>
        </label>
        <div class="comparison-form-bottom">
          <button type="button" data-comparison-copy>{txt('copyFeedback')}</button>
          <span data-comparison-status role="status" aria-live="polite"></span>
        </div>
      </form>
    </section>
    <div class="comparison-source">
      <span>{txt('scienceBoundary')}</span>
      <a href="https://github.com/wangrui2025/osa" target="_blank" rel="noopener noreferrer">{txt('sourceCode')} ↗</a>
    </div>
  </div>
</div>

<script>
  function mountComparison() {
    const root = document.querySelector<HTMLElement>('[data-osa-comparison]');
    if (!root || root.dataset.mounted === 'true') return;
    root.dataset.mounted = 'true';
    const form = root.querySelector<HTMLFormElement>('[data-comparison-form]');
    const button = root.querySelector<HTMLButtonElement>('[data-comparison-copy]');
    const feedback = root.querySelector<HTMLTextAreaElement>('[data-comparison-comment]');
    const status = root.querySelector<HTMLElement>('[data-comparison-status]');
    if (!form || !button || !feedback || !status) return;
    button.addEventListener('click', async () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="preferred"]:checked')?.value || 'Undecided';
      const message = 'OSA INTERACTIVE PAPER — AB COMPARISON\n'
        + 'Version A: https://wangrui2025.github.io/osa/en/explore/video-first/\n'
        + 'Version B: https://wangrui2025.github.io/osa/en/explore/network-first/\n'
        + 'Preference: ' + selected + '\n'
        + 'Specific likes / dislikes / what was difficult: ' + (feedback.value || '(not provided)') + '\n'
        + 'Please compare this feedback with my prior OSA preferences and record any confirmed changes.';
      try {
        await navigator.clipboard.writeText(message);
        status.textContent = root.dataset.lang === 'zh' ? '已复制。请粘贴到 ChatGPT 对话。' : 'Copied. Paste into our ChatGPT discussion.';
      } catch {
        status.textContent = root.dataset.lang === 'zh' ? '复制失败；请直接在对话中告诉我反馈。' : 'Copy unavailable; share the feedback in the conversation.';
      }
    });
  }
  document.addEventListener('astro:page-load', mountComparison);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountComparison, {once:true});
  else mountComparison();
</script>
<style>
  .comparison-shell{max-width: var(--osa-width-comparison);margin: auto;padding: 0 var(--osa-space-gutter) calc(var(--osa-space-unit) * 25.5);}
  .comparison-hero{max-width: var(--osa-width-intro);padding: calc(var(--osa-space-unit) * 20) 0 calc(var(--osa-space-unit) * 10);}
  .comparison-hero h1{font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-comparison-hero);line-height:var(--osa-leading-display);font-family:var(--osa-font-editorial);letter-spacing: var(--osa-tracking-comparison-title);margin: calc(var(--osa-space-unit) * 3) 0 calc(var(--osa-space-unit) * 5.5);}
  .comparison-hero>p:not(.study-kicker){font-size: var(--osa-study-text-lead);color: #627084;line-height: var(--osa-leading-relaxed);}
  .comparison-rules{display: flex;flex-wrap: wrap;gap: calc(var(--osa-space-unit) * 2.5);margin-top: calc(var(--osa-space-unit) * 6.5);}
  .comparison-rules span{font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-meta);line-height:var(--osa-leading-body);font-family:var(--osa-font-ui);color: #5866a0;background: #f1f3fc;border: 1px solid #e1e6f7;padding: calc(var(--osa-space-unit) * 2) calc(var(--osa-space-unit) * 3.5);border-radius: 100px;}
  .comparison-cards{display: grid;grid-template-columns: 1fr 1fr;gap: calc(var(--osa-space-unit) * 5);}
  .comparison-card{min-width: 0;border: 1px solid #dbe3ed;border-radius: 19px;overflow: hidden;background: #fff;box-shadow: 0 12px 35px #2734500a;}
  .comparison-thumbnail{background: #1b2a40;color: #e0eaff;min-height: 220px;padding: calc(var(--osa-space-unit) * 5.5) calc(var(--osa-space-unit) * 7);}
  .comparison-thumbnail--network-first{background: #f3f6ff;color: #2b3c5c;}
  .comparison-thumb-top{display: flex;justify-content: space-between;font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-micro);line-height:var(--osa-leading-body);font-family:var(--osa-font-ui);letter-spacing: var(--osa-tracking-technical);text-transform: uppercase;}
  .comparison-ultrasound{max-width: var(--osa-study-ultrasound-width);margin: auto;}
  .comparison-ultrasound svg{display: block;width: 100%;height: 155px;}
  .comparison-thumb-timeline{display: block;background: #78d8ca;height: 4px;width: 70%;border-radius: 5px;margin: calc(var(--osa-space-unit) * 1.5) auto;}
  .comparison-diagram{display: flex;gap: calc(var(--osa-space-unit) * 2.5);justify-content: center;align-items: center;flex-wrap: wrap;min-height: 165px;}
  .comparison-diagram span{font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-caption);line-height:var(--osa-leading-body);font-family:var(--osa-font-ui);background: #fff;border: 1px solid #ccd5ef;padding: calc(var(--osa-space-unit) * 4.5) calc(var(--osa-space-unit) * 3.5);border-radius: 9px;color: #495bac;}
  .comparison-diagram b{color: #8493ba;}
  .comparison-diagram div{flex-basis: 100%;text-align: center;font-weight:var(--osa-weight-semibold);font-size:var(--osa-study-text-label);line-height:var(--osa-leading-body);font-family:var(--osa-font-ui);color: #455481;}
  .comparison-card-body{padding: calc(var(--osa-space-unit) * 7.5) calc(var(--osa-space-unit) * 8) calc(var(--osa-space-unit) * 8.5);}
  .comparison-card-number{color: #495995;letter-spacing: var(--osa-tracking-technical);font-weight:var(--osa-weight-strong);font-size:var(--osa-study-text-label);line-height:var(--osa-leading-body);font-family:var(--osa-font-ui);}
  .comparison-card h2{font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-section);line-height:var(--osa-leading-heading);font-family:var(--osa-font-editorial);margin: calc(var(--osa-space-unit) * 2) 0;}
  .comparison-card p{color: #627187;min-height: 63px;line-height: var(--osa-leading-reading);font-size: var(--osa-study-text-body-small);}
  .osa-study .comparison-open{display: inline-flex;justify-content: space-between;align-items: center;gap: calc(var(--osa-space-unit) * 11);background: #344686;color: #fff;padding: calc(var(--osa-space-unit) * 3.5) calc(var(--osa-space-unit) * 5);font-weight: var(--osa-weight-bold);border-radius: 9px;margin-top: calc(var(--osa-space-unit) * 3.5);}
  .comparison-constants{margin-top: calc(var(--osa-space-unit) * 15.5);border-top: 1px solid #dde6f0;padding-top: calc(var(--osa-space-unit) * 11);}
  .comparison-constants h2,.comparison-feedback h2{font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-section);line-height:var(--osa-leading-body);font-family:var(--osa-font-editorial);}
  .comparison-constants>p,.comparison-feedback>div>p{color: #536176;margin: calc(var(--osa-space-unit) * 3) 0 calc(var(--osa-space-unit) * 5.5);}
  .comparison-constant-grid{display: grid;grid-template-columns: repeat(3,1fr);gap: calc(var(--osa-space-unit) * 4.5);}
  .comparison-constant-grid>div{background: #f5f7fb;border: 1px solid #e1e7f2;padding: calc(var(--osa-space-unit) * 5);border-radius: 12px;}
  .comparison-constant-grid span{color: #495995;font-weight:var(--osa-weight-bold);font-size:var(--osa-study-text-label);line-height:var(--osa-leading-body);font-family:var(--osa-font-ui);display: block;}
  .comparison-constant-grid strong{display: block;font-size: var(--osa-study-text-emphasis);margin: calc(var(--osa-space-unit) * 2.5) 0;}
  .comparison-constant-grid p{font-size: var(--osa-study-text-meta);color: #536176;line-height: var(--osa-leading-reading);}
  .comparison-feedback{margin-top: calc(var(--osa-space-unit) * 16.5);display: grid;grid-template-columns: .8fr 1.2fr;gap: calc(var(--osa-space-unit) * 8);padding: calc(var(--osa-space-unit) * 8);background: #f1f5fc;border: 1px solid #e0e7f1;border-radius: 18px;}
  .comparison-feedback .comparison-privacy{font-size: var(--osa-study-text-meta);color: #64758b;}
  .comparison-form{display: grid;gap: calc(var(--osa-space-unit) * 4);}
  .comparison-form fieldset{border: 0;padding: 0;display: flex;flex-wrap: wrap;gap: calc(var(--osa-space-unit) * 2.5);}
  .comparison-form legend{font-weight: var(--osa-weight-strong);margin-bottom: calc(var(--osa-space-unit) * 3);}
  .comparison-form fieldset label{display: inline-flex;align-items: center;gap: calc(var(--osa-space-unit) * 2);cursor: pointer;background: #fff;border: 1px solid #dce4ef;border-radius: 100px;padding: calc(var(--osa-space-unit) * 2) calc(var(--osa-space-unit) * 3);font-size: var(--osa-study-text-meta);}
  .comparison-form input{accent-color: #545fc0;}
  .comparison-write{display: grid;gap: calc(var(--osa-space-unit) * 2.5);font-size: var(--osa-study-text-caption);font-weight: var(--osa-weight-bold);}
  .comparison-write textarea{border: 1px solid #ccd8e8;border-radius: 9px;resize: vertical;min-height: 110px;padding: calc(var(--osa-space-unit) * 3) calc(var(--osa-space-unit) * 3.5);background: #fff;color: #24344d;font-size: var(--osa-study-text-caption);}
  .comparison-form-bottom{display: flex;align-items: center;gap: calc(var(--osa-space-unit) * 3.5);flex-wrap: wrap;}
  .comparison-form-bottom button{background: #344686;color: #fff;padding: calc(var(--osa-space-unit) * 3) calc(var(--osa-space-unit) * 5);border: 0;border-radius: 9px;font-weight: var(--osa-weight-bold);}
  .comparison-form-bottom span{font-size: var(--osa-study-text-meta);color: #5269a5;}
  .comparison-source{border-top: 1px solid #e2e8f2;margin-top: calc(var(--osa-space-unit) * 14.5);padding-top: calc(var(--osa-space-unit) * 5.5);display: flex;justify-content: space-between;gap: calc(var(--osa-space-unit) * 4.5);color: #536176;font-size: var(--osa-study-text-meta);}
  .comparison-source a{font-weight: var(--osa-weight-bold);color: #495cba;}
  @media(max-width:730px){
    .comparison-hero{padding-top: calc(var(--osa-space-unit) * 12.5);}
    .comparison-cards,.comparison-constant-grid,.comparison-feedback{grid-template-columns: 1fr;}
    .comparison-card p{min-height: 0;}
    .comparison-feedback{padding: calc(var(--osa-space-unit) * 5.5);}
    .comparison-source{flex-direction: column;}
  }
</style>
