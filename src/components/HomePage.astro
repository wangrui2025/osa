---
import Layout from '../layouts/Layout.astro';
import Section from './Section.astro';
import ActionButton from './ActionButton.astro';
import CopyButton from './CopyButton.astro';
import { getScholarlyArticleSchema } from '../utils/structuredData';
import { t } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getAcademicImage } from '../utils/cdn';

const figOverview = getAcademicImage('publications/cvpr2026-osa/fig/Met/fig_overview.png');
const figChallenge = getAcademicImage('publications/cvpr2026-osa/fig/challenge/image.png');
const figOsu = getAcademicImage('publications/cvpr2026-osa/fig/osu/fig_osu.png');
const figApfe = getAcademicImage('publications/cvpr2026-osa/fig/apfe/fig_apfe.png');
const tabCap = getAcademicImage('publications/cvpr2026-osa/tab/tab_cap.png');
const tabAbl = getAcademicImage('publications/cvpr2026-osa/tab/tab_abl.png');
const figExp = getAcademicImage('publications/cvpr2026-osa/fig/Exp/image.png');
const cvprLogo = getAcademicImage('logos/cvpr2026.png');

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;

const schema = getScholarlyArticleSchema({
  title: t(lang, 'publicationTitle'),
  authors: ['Rui Wang', 'Huisi Wu', 'Jing Qin'],
  description: t(lang, 'description'),
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(figOverview, Astro.site).href,
  venue: 'CVPR 2026',
  pdfUrl: 'https://arxiv.org/abs/2603.26188',
  codeUrl: 'https://github.com/wangrui2025/OSA',
  // Required by Google Rich Results test for ScholarlyArticle.
  // Source of truth: ASTRO_PUBLICATION_DATE env var (defaults to TBD placeholder
  // for unconfirmed acceptance date). Set in CI before build.
  datePublished: import.meta.env.PUBLIC_OSA_PUBLICATION_DATE ?? '2026-06-01',
  inLanguage: lang,
});
---

<Layout title={t(lang, 'title')} description={t(lang, 'description')} structuredData={schema}>
  <!-- Hero -->
  <section class="relative bg-gray-50 dark:bg-gray-800 pb-12 pt-8">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center">
        <!-- CVPR Logo -->
        <div class="mb-6">
          <img
            src={cvprLogo}
            alt="CVPR 2026"
            width="200"
            height="56"
            class="h-14 w-auto mx-auto lg:absolute lg:top-8 lg:left-8 lg:mx-0"
            loading="eager"
          />
        </div>

        <h1 class="publication-title mt-4">
          {t(lang, 'publicationTitle')}
        </h1>

        <p class="text-lg mt-4 text-gray-500 dark:text-gray-400">
          {t(lang, 'venueFull')}
        </p>

        <div class="text-lg mt-6 font-medium">
          {
            (lang === 'zh'
              ? [
                  { name: '王锐', sup: '1' },
                  { name: '吴惠思', sup: '1,*' },
                  { name: '秦璟', sup: '2' },
                ]
              : [
                  { name: 'Rui Wang', sup: '1' },
                  { name: 'Huisi Wu', sup: '1,*' },
                  { name: 'Jing Qin', sup: '2' },
                ]
            ).map((a, i, arr) => (
              <span class="mx-1">{a.name}<sup>{a.sup}</sup>{i < arr.length - 1 ? ',' : ''}</span>
            ))
          }
        </div>

        <div class="text-sm mt-3 text-gray-500 dark:text-gray-400">
          <div><sup>1</sup>{t(lang, 'affiliation1')}</div>
          <div><sup>2</sup>{t(lang, 'affiliation2')}</div>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mt-8">
          <ActionButton href="https://arxiv.org/abs/2603.26188" icon="lucide:file-text" target="_blank">
            {t(lang, 'arxivLabel')}
          </ActionButton>
          <ActionButton href="https://github.com/wangrui2025/OSA" icon="lucide:github" target="_blank">
            {t(lang, 'codeLabel')}
          </ActionButton>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture Overview -->
  <Section>
    <div class="figure-card">
      <img
        src={figOverview}
        alt="OSA Architecture Overview"
        width="1200"
        height="600"
        loading="eager"
      />
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 text-justify mt-4 leading-relaxed">
      <strong>Figure 1.</strong> {t(lang, 'fig1Caption')}
    </p>
  </Section>

  <!-- Abstract -->
  <Section>
    <div class="abstract-box">
      <h2 class="text-3xl font-semibold text-center mb-6 font-display">{t(lang, 'abstractTitle')}</h2>
      <div class="text-justify fade-in space-y-4">
        <p>{t(lang, 'abstractP1')}</p>
        <p>{t(lang, 'abstractP2')}</p>
        {t(lang, 'abstractP3') && <p>{t(lang, 'abstractP3')}</p>}
        {t(lang, 'abstractP4') && <p>{t(lang, 'abstractP4')}</p>}
      </div>
    </div>
  </Section>

  <!-- Motivation / Challenges -->
  <Section>
    <h2 class="text-3xl font-semibold text-center mb-6 font-display">{t(lang, 'motivationTitle')}</h2>
    <p class="text-gray-500 dark:text-gray-400 mb-8">{t(lang, 'motivationDesc')}</p>

    <div class="figure-card">
      <img
        src={figChallenge}
        alt="Challenges in echocardiography segmentation"
        width="1200"
        height="400"
        loading="lazy"
      />
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 text-justify mt-4 leading-relaxed">
      <strong>Figure 2.</strong> {t(lang, 'fig2Caption')}
    </p>
  </Section>

  <!-- Method -->
  <Section>
    <h2 class="text-3xl font-semibold text-center mb-6 font-display">{t(lang, 'methodTitle')}</h2>

    <!-- OSU -->
    <div class="mb-12">
      <h3 class="text-xl font-semibold mb-4 text-gray-900 dark:text-gray-100">{t(lang, 'methodOsuTitle')}</h3>
      <p class="text-gray-500 dark:text-gray-400 mb-6">{t(lang, 'methodOsuDesc')}</p>
      <div class="figure-card">
        <img
          src={figOsu}
          alt="Orthogonalized State Update mechanism"
          width="1200"
          height="500"
          loading="lazy"
        />
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 text-justify mt-4 leading-relaxed">
        <strong>Figure 3.</strong> {t(lang, 'fig3Caption')}
      </p>
    </div>

    <!-- APFE -->
    <div class="mb-8">
      <h3 class="text-xl font-semibold mb-4 text-gray-900 dark:text-gray-100">{t(lang, 'methodApfeTitle')}</h3>
      <p class="text-gray-500 dark:text-gray-400 mb-6">{t(lang, 'methodApfeDesc')}</p>
      <div class="figure-card">
        <img
          src={figApfe}
          alt="Anatomical Prior-aware Feature Enhancement module"
          width="1200"
          height="500"
          loading="lazy"
        />
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 text-justify mt-4 leading-relaxed">
        <strong>Figure 4.</strong> {t(lang, 'apfeCaption')}
      </p>
    </div>
  </Section>

  <!-- Results -->
  <Section>
    <h2 class="text-3xl font-semibold text-center mb-6 font-display">{t(lang, 'resultsTitle')}</h2>
    <p class="text-gray-500 dark:text-gray-400 mb-8">{t(lang, 'resultsDesc')}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Quantitative Results Table -->
      <div class="figure-card">
        <img
          src={tabCap}
          alt="Comparison with state-of-the-art methods"
          width="600"
          height="400"
          loading="lazy"
        />
        <p class="figure-caption">
          <strong>Table 1.</strong> {t(lang, 'table1Caption')}
        </p>
      </div>

      <!-- Ablation Study -->
      <div class="figure-card">
        <img
          src={tabAbl}
          alt="Ablation study results"
          width="600"
          height="400"
          loading="lazy"
        />
        <p class="figure-caption">
          <strong>Table 2.</strong> {t(lang, 'table2Caption')}
        </p>
      </div>
    </div>

    <!-- Qualitative Results -->
    <div class="figure-card">
      <img
        src={figExp}
        alt="Qualitative segmentation results"
        width="1200"
        height="500"
        loading="lazy"
      />
      <p class="text-sm text-gray-600 dark:text-gray-400 text-justify mt-4 leading-relaxed">
        <strong>Figure 5.</strong> {t(lang, 'fig4Caption')}
      </p>
    </div>
  </Section>

  <!-- BibTeX -->
  <Section id="bibtex">
    <h2 class="text-3xl font-semibold text-center mb-6 font-display">{t(lang, 'bibtexTitle')}</h2>
    <div class="relative">
      <CopyButton targetId="bibtex-content" label={t(lang, 'copyLabel')} successLabel={t(lang, 'copiedLabel')} />
      <pre><code id="bibtex-content">{t(lang, 'bibtexEntry')}</code></pre>
    </div>
  </Section>

  <!-- Resources -->
  <Section class="pb-8">
    <div class="text-center">
      <h2 class="text-3xl font-semibold text-center mb-6 font-display">{t(lang, 'resourcesTitle')}</h2>
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <ActionButton
          href="https://openaccess.thecvf.com/content/CVPR2026/html/Wang_OSA_Echocardiography_Video_Segmentation_via_Orthogonalized_State_Update_and_Anatomical_CVPR_2026_paper.html"
          icon="lucide:file-text"
          target="_blank"
        >
          {t(lang, 'pdfLabel')}
        </ActionButton>
        <ActionButton href={getRelativeLocaleUrl(lang, 'poster')} icon="lucide:presentation">
          {t(lang, 'posterLabel')}
        </ActionButton>
        <ActionButton href={getRelativeLocaleUrl(lang, 'slides')} icon="lucide:monitor">
          {t(lang, 'slidesLabel')}
        </ActionButton>
      </div>
    </div>
  </Section>
</Layout>
