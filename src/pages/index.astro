---
import { getRelativeLocaleUrl } from 'astro:i18n';

const target = getRelativeLocaleUrl('en', '/');
// Canonical and hreflang should point to the actual English page (not the
// bare /osa/ redirector). x-default explicitly tells crawlers the
// default-locale URL, which prevents indexing the redirect itself.
const canonical = `${Astro.site?.origin}${target}`;
---
<!doctype html>
<html>
  <head>
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
  </head>
  <body>
    <a href={target}>Redirecting to English version...</a>
  </body>
</html>
