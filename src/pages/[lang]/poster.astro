---
import Layout from '../../layouts/Layout.astro';
import Poster from '../../components/Poster.astro';
import { t } from '../../i18n/index.ts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as 'en' | 'zh';
const title = t(lang, 'poster.title');
const description = t(lang, 'poster.description');
---
<Layout title={title} description={description} showFooter={false} class="osa-poster-page">
  <Poster lang={lang} />
</Layout>

<style is:global>
  /* Scoped to the poster page only via the .osa-poster-page class on the
     <html> root element, set through Layout's class prop. Without this
     scope, the @page rule and html:has(.osa-poster-root) selectors would
     leak into any other page that happens to render a Poster component. */
  .osa-poster-page {
    overflow: hidden;
  }
  @page {
    size: 84in 42in;
    margin: 0;
  }
  @media print {
    .osa-poster-page {
      overflow: visible !important;
      margin: 0 !important;
    }
    .osa-poster-page body > div.fixed {
      display: none !important;
    }
  }
</style>
