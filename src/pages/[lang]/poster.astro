---
import Layout from '../../layouts/Layout.astro';
import Poster from '../../components/Poster.astro';
import { t } from '../../i18n/index.ts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as 'en' | 'zh';
const title = t(lang, 'poster.title');
const description = t(lang, 'poster.description');
---
<Layout title={title} description={description} showFooter={false}>
  <Poster />
</Layout>

<style is:global>
  html:has(.osa-poster-root),
  html:has(.osa-poster-root) body {
    overflow: hidden;
  }
</style>
