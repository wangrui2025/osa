---
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
  ];
}

// Lang param comes from the dynamic [lang] route — guarantees each
// locale has its own 404 page (no more broken lang switch from
// /404 → /zh/404/ which doesn't exist).
const { lang } = Astro.params as { lang: 'en' | 'zh' };
---

<Layout title={t(lang, 'notFoundTitle')} showFooter={false} noindex>
  <div class="min-h-[60vh] flex flex-col items-center justify-center px-4">
    <h1 class="text-6xl font-bold text-primary mb-4">404</h1>
    <p class="text-lg text-text-muted dark:text-text-muted-dark mb-8">
      {t(lang, 'notFound')}
    </p>
    <a
      href={getRelativeLocaleUrl(lang, '/')}
      class="action-btn action-btn-primary"
      aria-label={t(lang, 'backHome')}
    >
      {t(lang, 'backHome')}
    </a>
  </div>
</Layout>
