---
import '@fontsource/noto-sans/400.css';
import '@fontsource/noto-sans/700.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  showFooter?: boolean;
  structuredData?: object;
}

const {
  title,
  description = 'OSA: Echocardiography Video Segmentation via Orthogonalized State Update and Anatomical Prior-aware Feature Enhancement',
  image = 'https://cdn.jsdelivr.net/gh/mykcs/academic@2d8a325/images/publications/cvpr2026-osa/fig/Met/fig_overview.png',
  showFooter = true,
  structuredData,
} = Astro.props;

const lang = Astro.currentLocale ?? 'en';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8">
    <style is:inline>
      :root {
        --bg-color: #ffffff;
        --text-color: #374151;
      }
      html.dark {
        --bg-color: #111827;
        --text-color: #e5e7eb;
      }
      html {
        background-color: var(--bg-color);
        color: var(--text-color);
      }
      body {
        margin: 0;
        min-height: 100vh;
      }
    </style>
    <script is:inline>
      (function() {
        function applyTheme() {
          const theme = localStorage.getItem('theme')
            || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.toggle('dark', theme === 'dark');
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#111827' : '#ffffff');
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <meta name="description" content={description}>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <!-- Language alternates for SEO -->
    <link rel="alternate" hreflang="en" href={new URL('/osa/en/', Astro.site).href} />
    <link rel="alternate" hreflang="zh" href={new URL('/osa/zh/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/osa/en/', Astro.site).href} />

    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <ClientRouter fallback="none" />
    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-white text-gray-700 dark:bg-gray-900 dark:text-gray-200 transition-colors min-h-screen flex flex-col">
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
      <ThemeToggle />
      <LangSwitcher />
    </div>
    <main class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer />}
    <script src="../scripts/delegation.ts" />
  </body>
</html>
