---
import '@fontsource/noto-sans/400.css';
import '@fontsource/noto-sans/700.css';
import { ClientRouter } from 'astro:transitions';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  showFooter?: boolean;
  structuredData?: object;
  noindex?: boolean;
  class?: string;
}

const {
  title,
  description = 'OSA: Echocardiography Video Segmentation via Orthogonalized State Update and Anatomical Prior-aware Feature Enhancement',
  // Per-page image override (e.g. paper hero from getAcademicImage()).
  // Default falls back to a locale-aware OG image (og-home-en/zh.png)
  // so social share cards on /en/ and /zh/ differ. Round 22 P1
  // (cross-site audit 2026-07-26). Paper pages still pass a CDN-hosted
  // hero via the `image` prop and keep their override.
  image,
  imageWidth = 2510,
  imageHeight = 652,
  showFooter = true,
  structuredData,
  noindex = false,
  class: className,
} = Astro.props;

const lang = Astro.currentLocale === 'zh' ? 'zh' : 'en';
const structuredDataJson = structuredData ? JSON.stringify(structuredData) : null;
const defaultOgImage = `${import.meta.env.BASE_URL}/images/og-home-${lang}.png`;
const ogImage = new URL(image ?? defaultOgImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang={lang} class={className}>
  <head>
    <meta charset="utf-8">
    <style is:inline>
      :root {
        --bg-color: #ffffff;
        --text-color: #374151;
      }
      html.dark {
        --bg-color: #111827;
        --text-color: #e5e7eb;
      }
      html {
        background-color: var(--bg-color);
        color: var(--text-color);
      }
      body {
        margin: 0;
        min-height: 100vh;
      }
    </style>
    <script is:inline>
      (function() {
        function applyTheme() {
          const theme = localStorage.getItem('theme')
            || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.toggle('dark', theme === 'dark');
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#111827' : '#ffffff');
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <meta name="description" content={description}>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Security policy supported by CSP meta delivery on GitHub Pages:
         - base-uri 'self' prevents <base> hijacking
         - form-action 'self' blocks form submission to external origins
         - Referrer-Policy strict-origin-when-cross-origin limits referrer leakage -->
    <meta http-equiv="Content-Security-Policy" content="base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OSA Project" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <!-- Language alternates for SEO. Path-aware: /en/poster/ ↔ /zh/poster/.
         Uses Astro's getAbsoluteLocaleUrl so base/locale handling stays in sync. -->
    {(() => {
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const altPath = Astro.url.pathname.replace(new RegExp(`^${base}/(en|zh)/?`), '/') || '/';
      return (
        <>
          <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en', altPath)} />
          <link rel="alternate" hreflang="zh" href={getAbsoluteLocaleUrl('zh', altPath)} />
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', altPath)} />
        </>
      );
    })()}

    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/favicon-512.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}/manifest.json`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <ClientRouter fallback="none" />
    {structuredData && (
      /* TRUSTED: static JSON.stringify of academic data, served as application/ld+json. */
      <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    )}
  </head>
  <body class="bg-white text-gray-700 dark:bg-gray-900 dark:text-gray-200 transition-colors min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
      <ThemeToggle />
      <LangSwitcher />
    </div>
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer />}
    <script src="../scripts/delegation.ts" />
  </body>
</html>
